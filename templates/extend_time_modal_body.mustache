{{!
    @template quiz_livequizmonitor/extend_time_modal_body

    Modal body for extending quiz attempt time.

    Example context (json):
    {
        "description": "Extend time for Jane Student.",
        "addtimelabel": "Presets",
        "presets": [
            {"minutes": 5, "active": false},
            {"minutes": 10, "active": true},
            {"minutes": 15, "active": false}
        ],
        "customlabel": "Custom minutes",
        "custommax": 180,
        "customvalue": 10,
        "previewlabel": "New end time",
        "previewvalue": "12:30"
    }
}}
<div class="livequizmonitor-extend-modal-body">
    <p class="livequizmonitor-extend-description" data-region="extend-description">{{description}}</p>

    <div class="mb-3">
        <div class="font-weight-bold mb-2">{{addtimelabel}}</div>
        <div class="livequizmonitor-extend-presets btn-group mb-2" role="group" aria-label="{{addtimelabel}}">
            {{#presets}}
            <button type="button"
                    class="btn btn-outline-secondary livequizmonitor-extend-preset{{#active}} active{{/active}}"
                    data-minutes="{{minutes}}">
                +{{minutes}}m
            </button>
            {{/presets}}
        </div>
        <label class="d-block font-weight-bold" for="livequizmonitor-extend-custom">
            {{customlabel}}
        </label>
        <input type="text"
               inputmode="numeric"
               pattern="[0-9]*"
               id="livequizmonitor-extend-custom"
               class="form-control livequizmonitor-extend-custom"
               data-region="extend-custom"
               data-max="{{custommax}}"
               value="{{customvalue}}">
        <div class="invalid-feedback" data-region="extend-custom-error"></div>
    </div>

    <div>
        <div class="font-weight-bold mb-1" data-region="extend-preview-label">{{previewlabel}}</div>
        <div class="livequizmonitor-extend-preview text-muted" data-region="extend-preview">{{previewvalue}}</div>
    </div>
</div>
