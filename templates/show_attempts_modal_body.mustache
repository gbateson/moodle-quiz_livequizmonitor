{{!
    @template quiz_livequizmonitor/show_attempts_modal_body
    Template for rendering student quiz attempts inside the live monitor modal.
    Classes required for JS:
    * none
    Data context required for this template:
    * userid {int} The ID of the student being viewed.
    * courseid {int} The ID of the course context.
    * studentname {string} The full display name of the student.
    * hasattempts {bool} True if one or more attempts exist.
    * attempts {array} List of quiz attempts.
        * id {int} Attempt ID.
        * attempt {int} Attempt number.
        * state {string} Attempt state.
        * timestart {int} Unix timestamp of attempt start.
        * timefinish {int} Unix timestamp of attempt finish.
        * timestartformatted {string} Human-readable start date/time.
        * timefinishformatted {string} Human-readable finish date/time.

    Example context (json):
    {
        "userid": 5,
        "courseid": 2,
        "studentname": "Jane Student",
        "hasattempts": true,
        "attempts": [
            {
                "id": 101,
                "attempt": 1,
                "state": "finished",
                "timestart": 1750000000,
                "timefinish": 1750003600,
                "timestartformatted": "1 January 2026, 10:00 AM",
                "timefinishformatted": "1 January 2026, 11:00 AM"
            }
        ]
    }
}}

<div class="livequizmonitor-show-attempts-modal">
    {{#hasattempts}}
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} attemptnumber, quiz {{/str}}</th>
                        <th scope="col">{{#str}} timestart, quiz_livequizmonitor {{/str}}</th>
                        <th scope="col">{{#str}} timefinish, quiz_livequizmonitor {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#attempts}}
                        <tr>
                            <td>
                                {{attempt}}
                                <span class="badge bg-light text-dark border">{{state}}</span>
                            </td>
                            <td class="text-nowrap small text-muted">
                                {{timestartformatted}}
                            </td>
                            <td class="text-nowrap small text-muted">
                                {{#timefinishformatted}}
                                    {{timefinishformatted}}
                                {{/timefinishformatted}}
                                {{^timefinishformatted}}
                                    -
                                {{/timefinishformatted}}
                            </td>
                        </tr>
                    {{/attempts}}
                </tbody>
            </table>
        </div>
    {{/hasattempts}}

    {{^hasattempts}}
        <div class="alert alert-info mb-0" role="alert">
            {{#str}} attempts:noattempts, quiz_livequizmonitor {{/str}}
        </div>
    {{/hasattempts}}
</div>